      <param name="datarate" value="100Mbps" />
      <param name="delay" value="25ms" />
    </connect>
    <connect src-module="right[1]" src-gate="pppg$o[0]" dest-module="left[1]" dest-gate="pppg$i[0]" channel-type="ned.DatarateChannel">
      <param name="datarate" value="100Mbps" />
      <param name="delay" value="25ms" />
    </connect>
    <start module="left[0].ppp[0]" />
    <start module="right[0].ppp[0]" />
    <start module="left[1].ppp[0]" />
    <start module="right[1].ppp[0]" />
    <update module="configurator" />
  </at>
  <at t="30s">
    <disconnect src-module="left[0]" src-gate="pppg$o[0]" />
